# =============================================================================
#  模板：复制为 .env 后使用       copy .env.example .env
#  注意：这里面的密码只用于本地开发。推到公开仓库前把值换成占位符，
#        生产环境用强随机串（openssl rand -base64 32）。
# =============================================================================

# ------------------------- MySQL（主存储）------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=CyanWorks
MYSQL_USER=Cyan
# 密码一律留占位符：本仓库是公开仓库，禁止提交真实凭据。
# 本地开发请 copy .env.example .env 后填入自己的密码（.env 已被 .gitignore 忽略）。
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-root-password
JPA_DDL=update

# ---------------------------- Redis（缓存层）----------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
APP_KEY_PREFIX=Cyan:
APP_CACHE_ENABLED=true
APP_CACHE_TTL=300

# ---------------------------- JWT -------------------------------------------
JWT_SECRET=replace-me-with-openssl-rand-base64-64
JWT_ACCESS_TTL=7200
JWT_REMEMBER_TTL=1209600

# ------------------------- 登录防护 -----------------------------------------
LOGIN_MAX_FAILED=5
LOGIN_LOCK_SECONDS=900
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=120

# ---------------------------- CORS ------------------------------------------
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------- 文件上传 -----------------------------------------
# 服务器 / Docker 上务必用【绝对路径】：相对路径会跟着 java 进程的工作目录解析，
# 换目录或换启动方式启服，素材就会"消失"（实际写到别处，/media/ 全部 404）。
APP_UPLOAD_DIR=/var/lib/portfolio/upload
# 本机 Windows 开发可改成 ./data/upload（前提是必须在仓库根目录启动后端）

# --------------------- 初始管理员（仅首次播种使用） -------------------------
ADMIN_USERNAME=Cyan
ADMIN_PASSWORD=replace-me

# ------------------------- 前端运行时变量 -----------------------------------
VITE_API_BASE=/api

# ------------------------- 生产部署（docker compose）------------------------
# 对外暴露的端口；前面挂 Caddy/Nginx 做 HTTPS 时改成 8081 等内网端口
HTTP_PORT=80
# JPA 建表策略：update = 自动对齐实体（默认，最省心）；稳定后可改 validate
JPA_DDL=update
