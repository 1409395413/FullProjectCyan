# ================= secrets =================
.env
.env.local
*.env.local
*.env
*.pem
!*.env.example
server/src/main/resources/application-prod.yml

# ================= Java =================
target/
*.class
*.jar
!server/**/*.jar
.mvn/
mvnw
mvnw.cmd

# ================= Node =================
node_modules/
web/dist/
web/.vite/
*.local

# ================= build artifacts =================
# 打包产物是构建输出，不是源码：进仓库会不断膨胀且夹带本机路径/配置
*.zip
*.tar.gz
deploy.zip
deploy.tar.gz
portfolio-deploy-package.zip

# ================= migration packages =================
# 迁移包含全量素材（几百 MB）和整库 dump，是导出产物不是源码。
# 进仓库会让体积失控，且可能夹带线上真实内容。
portfolio-migration-*.tar.gz

# ================= data =================
# 站点内容与素材都在容器卷里，绝不进仓库（重新部署才不会覆盖线上数据）
data/
*.log
/backup/
/_smoke/
/uploads/

# 本机会话/记忆数据，与项目无关，绝不进仓库
.workbuddy/

# ================= local toolchain / OS =================
.toolchain/
C:/Users/Administrator/.toolchain/
.DS_Store
Thumbs.db
desktop.ini

# ================= IDE =================
.idea/
.vscode/*
!.vscode/settings.json
*.iml
